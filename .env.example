# Application (client) ID from your Microsoft Entra app registration.
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Use "consumers" for an app registered for personal Microsoft accounts only.
# Work/school accounts should use their tenant ID.
MICROSOFT_TENANT_ID=consumers

# Comma-separated full-address prefixes. For this cleaner, info@----- matches
# randomized addresses such as info@-----mail.FnopEKGKj0M9cG.com.
TARGET_EMAIL_PREFIXES=info@-----

# Keep true until the logs show only messages you intend to remove.
DRY_RUN=true

# Daily schedule, interpreted in TZ.
RUN_AT=08:00
TZ=America/Chicago

# Also clean immediately whenever the service starts.
RUN_ON_STARTUP=true

LOG_LEVEL=INFO
