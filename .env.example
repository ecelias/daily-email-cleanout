# Application (client) ID from your Microsoft Entra app registration.
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Use "common" for personal Microsoft accounts, or your tenant ID for an
# organization-restricted app.
MICROSOFT_TENANT_ID=common

# Comma-separated sender domains. Exact domains and their subdomains match.
TARGET_DOMAINS=example.com

# Optional comma-separated full-address prefixes. This is useful when the
# domain changes but the beginning is stable. For example, info@----- matches
# info@-----mail.FnopEKGKj0M9cG.com. Leave blank if unused.
TARGET_EMAIL_PREFIXES=

# Keep true until the logs show only messages you intend to remove.
DRY_RUN=true

# Daily schedule, interpreted in TZ.
RUN_AT=08:00
TZ=America/Chicago

# Also clean immediately whenever the service starts.
RUN_ON_STARTUP=true

LOG_LEVEL=INFO
